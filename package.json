{
  "name": "lease-audit",
  "version": "1.0.0",
  "private": true,
  "description": "100% local-first, statute-grounded residential lease auditing engine against federal and state landlord-tenant laws",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:policies": "node scripts/validate-policies.mjs",
    "audit:claims": "node scripts/audit-claims.mjs"
  },
  "dependencies": {
    "@knowthankyew/policy-packs": "^1.0.2",
    "@knowthankyew/privacy-telemetry": "^1.0.2",
    "lucide-react": "^1.80.0",
    "onnxruntime-web": "^1.31.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^5.5.4",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
